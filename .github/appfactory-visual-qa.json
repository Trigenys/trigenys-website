{
  "version": 1,
  "routes": [
    {
      "path": "/",
      "primaryCtaSelector": "a[data-cta='primary']",
      "expectedCtaHref": "/#contact"
    },
    {
      "path": "/en/",
      "primaryCtaSelector": "a[data-cta='primary']",
      "expectedCtaHref": "/en/#contact"
    },
    {
      "path": "/produits/atelier-maitre/",
      "primaryCtaSelector": "a[data-cta='primary']",
      "expectedCtaHref": "/produits/atelier-maitre/#contact"
    }
  ],
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 900 },
    { "name": "mobile", "width": 390, "height": 844 }
  ],
  "budgets": {
    "maxLcpMs": 2500,
    "maxCls": 0.1,
    "maxTotalBlockingTimeMs": 200
  },
  "requireReducedMotion": true,
  "requireNoHorizontalOverflow": true,
  "requireNoExternalImages": true
}
